#!/usr/bin/env bash
# Read-only access to a project's PRODUCTION site for /ada:bughunt. Only the commands below are
# allowed; anything else is refused before it reaches the server. Writes, replication and fix
# attempts happen on a local site, never here.
#
#   prod-wp config                              show the settings in use (nothing is sent)
#   prod-wp sql "SELECT ..."                    one SELECT / SHOW / DESCRIBE / EXPLAIN;
#                                               write {prefix} for the table prefix:
#                                               SELECT ID FROM {prefix}posts ...
#   prod-wp inspect <script> [args...]          a READ-ONLY script from the project's tools/bughunt/,
#                                               run behind a guard that blocks writes (below)
#   prod-wp notes <order or subscription id> [count]    order notes, newest first
#   prod-wp option <name>                       wp option get
#   prod-wp actions <list|get|next> [args...]   wp action-scheduler action, read-only subcommands
#   prod-wp logs list [source]                  WooCommerce log files, newest first
#   prod-wp logs tail <file> [lines]
#   prod-wp logs grep <fixed text> [source]     matching lines across log files
#
# Settings come from .claude/team/prod.env at the root of the current git repo, as KEY=value
# lines. The file is parsed, never executed. An environment variable of the same name overrides
# the file.
#
#   PROD_SSH=install@install.ssh.wpengine.net      required; your own SSH key does the auth
#   PROD_PREFIX=wp_                                 the production table prefix
#   PROD_LOGS=sites/install/wp-content/uploads/wc-logs
#   PROD_FORBIDDEN=expensive_view feedback      names (tables, views, post types) that may not
#                                               appear in a query. While it is set, a query on
#                                               {prefix}posts or {prefix}postmeta must also name
#                                               its post_type or its IDs, so it can't return rows
#                                               of a forbidden post type without naming it.
#
# Read-only is enforced, not trusted. sql runs in a READ ONLY MySQL session. An inspector is
# refused if its code calls a known write function, and on the server it runs after a guard that
# puts the session READ ONLY, drops every query through $wpdb that isn't SELECT, SHOW, DESCRIBE
# or EXPLAIN, and stops mail and outgoing HTTP requests. The guard can't stop file or object
# cache writes, which is what the scan is for; tools/bughunt/README.md has the rules.
#
# The WP Engine gateway re-parses inline commands and drops quotes, so remote commands are sent
# as a script on standard input, each argument quoted with printf %q.

set -euo pipefail

die() { echo "prod-wp: $*" >&2; exit 2; }
q() { printf '%q' "$1"; }

root="$(git rev-parse --show-toplevel 2>/dev/null)" || die 'run me from inside the project repo'
conf="$root/.claude/team/prod.env"

PROD_SSH_FILE='' PROD_PREFIX_FILE='wp_' PROD_LOGS_FILE='' PROD_FORBIDDEN_FILE=''
if [ -f "$conf" ]; then
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%%#*}"
		[[ "$line" =~ ^[[:space:]]*$ ]] && continue
		[[ "$line" =~ ^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || die "can't read this line in prod.env: $line"
		key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
		val="${val%"${val##*[![:space:]]}"}"
		[[ "$val" =~ ^\"(.*)\"$ || "$val" =~ ^\'(.*)\'$ ]] && val="${BASH_REMATCH[1]}"
		case "$key" in
			PROD_SSH) PROD_SSH_FILE="$val" ;;
			PROD_PREFIX) PROD_PREFIX_FILE="$val" ;;
			PROD_LOGS) PROD_LOGS_FILE="$val" ;;
			PROD_FORBIDDEN) PROD_FORBIDDEN_FILE="$val" ;;
			*) die "unknown setting in prod.env: $key" ;;
		esac
	done < "$conf"
fi
HOST="${PROD_SSH:-$PROD_SSH_FILE}"
PREFIX="${PROD_PREFIX:-$PROD_PREFIX_FILE}"
LOGS="${PROD_LOGS:-$PROD_LOGS_FILE}"
FORBIDDEN="${PROD_FORBIDDEN:-$PROD_FORBIDDEN_FILE}"

# Settings are checked before use, so a bad value can't change what runs on the server.
[[ -z "$HOST" || "$HOST" =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+$ ]] || die "PROD_SSH must look like user@host: $HOST"
[[ "$PREFIX" =~ ^[A-Za-z0-9_]+$ ]] || die "PROD_PREFIX may only hold letters, digits and _: $PREFIX"
[[ -z "$LOGS" || ( "$LOGS" =~ ^[A-Za-z0-9._/-]+$ && ! "$LOGS" =~ \.\. ) ]] || die "PROD_LOGS must be a plain path: $LOGS"
[[ "$FORBIDDEN" =~ ^[A-Za-z0-9_\ ]*$ ]] || die "PROD_FORBIDDEN is a space-separated list of names"

need_host() { [ -n "$HOST" ] || die "no PROD_SSH: add it to .claude/team/prod.env"; }
need_logs() { [ -n "$LOGS" ] || die "no PROD_LOGS: add it to .claude/team/prod.env"; }
run() { need_host; ssh -o BatchMode=yes -o ConnectTimeout=20 "$HOST" bash -s; }

# What an inspector may not call: WordPress and WooCommerce writes, hooks that run other code,
# the filesystem, processes, and ways round the guard. WRITE_CALLS_OK are the read-only names
# the broad patterns would catch.
WRITE_CALLS='(^|[^a-z0-9_$])((add|update|delete|set)_[a-z0-9_]+|(wc|wcs)_(create|update|delete|add|set|reduce|increase|cancel)[a-z0-9_]*|wp_(insert|create|update|delete|trash|untrash|publish|set|mail|schedule|unschedule|clear_scheduled|cache_(add|set|replace|delete|incr|decr|flush))[a-z0-9_]*|as_(schedule|enqueue|unschedule)[a-z0-9_]*|do_action(_ref_array)?|remove_(all_)?(filters?|actions?)|file_put_contents|fwrite|fputs|unlink|rename|rmdir|mkdir|copy|touch|chmod|exec|shell_exec|system|passthru|proc_open|popen|mysqli_[a-z_]+|eval)[[:space:]]*\(|->(save|delete|trash|untrash|insert|update|replace|cancel|refund|dbh)([^a-z0-9_]|$)'
WRITE_CALLS_OK='(^|[^a-z0-9_$])(add_query_arg|add_filter|add_action|set_time_limit|set_error_handler|wp_set_current_user)[[:space:]]*\('

# Sent ahead of every inspector and run on production before it. On a host without READ ONLY
# sessions the query filter still applies.
read -r -d '' GUARD <<'PHP' || true
<?php
// prod-wp's read-only guard. Edits belong in the plugin's bin/prod-wp, not here.
( static function () {
	$wpdb = $GLOBALS['wpdb'];
	$quiet = $wpdb->suppress_errors( true );
	if ( false === $wpdb->query( 'SET SESSION TRANSACTION READ ONLY' ) ) {
		fwrite( STDERR, "prod-wp: this database has no READ ONLY sessions; the query filter still applies\n" );
	}
	$wpdb->suppress_errors( $quiet );
	$blocked = static function ( $what ) {
		fwrite( STDERR, 'prod-wp: blocked ' . substr( preg_replace( '/\s+/', ' ', $what ), 0, 160 ) . "\n" );
	};
	add_filter(
		'query',
		static function ( $query ) use ( $blocked ) {
			$sql = preg_replace( '~^(\s+|/\*.*?\*/|\()+~s', '', (string) $query );
			if ( preg_match( '/^(SELECT|SHOW|DESCRIBE|DESC|EXPLAIN)\b/i', $sql )
				&& ! preg_match( '/\b(INTO\s+(OUT|DUMP)FILE|FOR\s+UPDATE|LOCK\s+IN\s+SHARE\s+MODE)\b/i', $sql ) ) {
				return $query;
			}
			$blocked( 'a write: ' . $query );
			return ''; // wpdb::query() returns false for an empty query.
		},
		PHP_INT_MAX
	);
	add_filter(
		'pre_wp_mail',
		static function ( $short, $atts ) use ( $blocked ) {
			$blocked( 'an email: ' . ( is_array( $atts ) && isset( $atts['subject'] ) ? $atts['subject'] : '' ) );
			return false;
		},
		PHP_INT_MAX,
		2
	);
	add_filter(
		'pre_http_request',
		static function ( $pre, $args, $url ) use ( $blocked ) {
			$blocked( 'an HTTP request: ' . $url );
			return new WP_Error( 'prod_wp_read_only', 'prod-wp: no outgoing requests from an inspector' );
		},
		PHP_INT_MAX,
		3
	);
} )();
PHP

[ $# -ge 1 ] || die "no command. See the header of $0."
cmd="$1"; shift

case "$cmd" in
config)
	echo "repo:       $root"
	echo "settings:   $conf$([ -f "$conf" ] || echo ' (missing)')"
	echo "ssh:        ${HOST:-(not set)}"
	echo "prefix:     $PREFIX"
	echo "logs:       ${LOGS:-(not set)}"
	echo "forbidden:  ${FORBIDDEN:-(none)}"
	echo "inspectors: $root/tools/bughunt/"
	;;
sql)
	[ $# -eq 1 ] || die 'sql takes one quoted statement'
	s="$1"
	shopt -s nocasematch
	[[ "$s" =~ ^[[:space:]]*(SELECT|SHOW|DESCRIBE|DESC|EXPLAIN)[[:space:]] ]] || die 'only SELECT, SHOW, DESCRIBE or EXPLAIN'
	[[ "$s" =~ \;[[:space:]]*[^[:space:]] ]] && die 'one statement only'
	[[ "$s" =~ (INTO[[:space:]]+(OUT|DUMP)FILE|FOR[[:space:]]+UPDATE|LOCK[[:space:]]+IN|SLEEP\(|BENCHMARK\() ]] && die 'not allowed in a read-only query'
	for name in $FORBIDDEN; do
		[[ "$s" =~ $name ]] && die "$name is on this project's never-query list (PROD_FORBIDDEN); query the underlying tables"
	done
	# A forbidden post type's rows come back from any posts query that doesn't narrow by type.
	if [ -n "$FORBIDDEN" ]; then
		[[ "$s" =~ (\{prefix\}|$PREFIX)posts([^A-Za-z0-9_]|$) && ! "$s" =~ post_type[[:space:]]*(=|IN[[:space:]]*\() && ! "$s" =~ (^|[^A-Za-z0-9_])ID[[:space:]]*(=|IN[[:space:]]*\()[[:space:]]*[0-9] ]] &&
			die "this project has a never-query list, so a query on {prefix}posts must name its post_type (post_type = '...' or IN (...)) or its IDs (ID = 123)"
		[[ "$s" =~ (\{prefix\}|$PREFIX)postmeta([^A-Za-z0-9_]|$) && ! "$s" =~ post_type[[:space:]]*(=|IN[[:space:]]*\() && ! "$s" =~ post_id[[:space:]]*(=|IN[[:space:]]*\()[[:space:]]*[0-9] ]] &&
			die "this project has a never-query list, so a query on {prefix}postmeta must name its post_id (post_id = 123) or join {prefix}posts and name the post_type"
	fi
	shopt -u nocasematch
	s="${s//\{prefix\}/$PREFIX}"
	echo "wp db query $(q "SET SESSION TRANSACTION READ ONLY; $s")" | run
	;;
inspect)
	[ $# -ge 1 ] || die 'inspect needs a script name'
	name="${1%.php}"; shift
	[[ "$name" =~ ^[a-z0-9-]+$ ]] || die 'script names are lower-case words and hyphens'
	file="$root/tools/bughunt/$name.php"
	[ -f "$file" ] || die "no script tools/bughunt/$name.php in this repo"
	head -5 "$file" | grep -q 'READ-ONLY' || die "tools/bughunt/$name.php is not marked READ-ONLY in its first five lines"
	grep -q 'ADA_BUGHUNT_' "$file" && die "tools/bughunt/$name.php may not contain ADA_BUGHUNT_ (prod-wp's own markers)"
	# Comment lines and trailing // comments are dropped first, so a comment naming a call is fine.
	writes="$(sed -E -e 's@^[[:space:]]*(\*|/\*|//|#).*$@@' -e 's@[[:space:]]//.*$@@' "$file" |
		grep -niE "$WRITE_CALLS" | grep -viE "$WRITE_CALLS_OK" || true)"
	[ -z "$writes" ] || die "tools/bughunt/$name.php calls something that writes, sends or runs; inspectors are read-only (tools/bughunt/README.md):
$writes"
	args=''; for a in "$@"; do args+=" $(q "$a")"; done
	# WP-CLI evals the script from standard input; the guard evals the inspector the same way.
	{ echo "wp eval-file -$args <<'ADA_BUGHUNT_PHP'"; echo "$GUARD"
		echo "eval( '?>' . <<<'ADA_BUGHUNT_INSPECTOR'"; cat "$file"; echo; echo 'ADA_BUGHUNT_INSPECTOR'; echo ');'
		echo 'ADA_BUGHUNT_PHP'; } | run
	;;
notes)
	[[ "${1:-}" =~ ^[0-9]+$ ]] || die 'notes needs a numeric id'
	n="${2:-30}"; [[ "$n" =~ ^[0-9]+$ ]] || die 'count must be a number'
	# WooCommerce hides order notes from comment queries, so read the table directly.
	echo "wp db query $(q "SELECT comment_date, comment_author, comment_content FROM ${PREFIX}comments WHERE comment_post_ID = $1 AND comment_type = 'order_note' ORDER BY comment_date DESC, comment_ID DESC LIMIT $n")" | run
	;;
option)
	[[ "${1:-}" =~ ^[A-Za-z0-9_-]+$ ]] || die 'option needs a name'
	echo "wp option get $(q "$1") --format=json" | run
	;;
actions)
	[[ "${1:-}" =~ ^(list|get|next)$ ]] || die 'actions allows list, get or next only'
	args=''; for a in "$@"; do args+=" $(q "$a")"; done
	echo "wp action-scheduler action$args" | run
	;;
logs)
	need_logs
	sub="${1:-}"; shift || true
	case "$sub" in
	list)
		src="${1:-}"; [[ "$src" =~ ^[a-z0-9-]*$ ]] || die 'bad source'
		echo "ls -t $(q "$LOGS") | grep -- $(q "^${src}") | head -40" | run ;;
	tail)
		[[ "${1:-}" =~ ^[A-Za-z0-9._-]+\.log$ ]] || die 'tail needs a log file name from logs list'
		n="${2:-200}"; [[ "$n" =~ ^[0-9]+$ ]] || die 'lines must be a number'
		echo "tail -n $n $(q "$LOGS/$1")" | run ;;
	grep)
		[ -n "${1:-}" ] || die 'grep needs the text to find'
		src="${2:-}"; [[ "$src" =~ ^[a-z0-9-]*$ ]] || die 'bad source'
		echo "grep -F -h -- $(q "$1") $(q "$LOGS")/${src}*.log | tail -n 300" | run ;;
	*) die 'logs list | tail | grep' ;;
	esac
	;;
*)
	die "unknown or not allowed: $cmd. Production is read-only; see the header of $0."
	;;
esac
