#!/usr/bin/env bash
# Runs the project's PressTest tests against the developer's local site, or the project's staging
# site, for Tess and for people. Run from inside the project repo.
#
#   presstest config                     show the settings in use; secrets show as (set). Nothing runs.
#   presstest list                       the project's test files, in tests/presstest/
#   presstest run [--env local|staging] [-b <browser>] [<test file> ...]
#                                        run the project's tests and its shared suites, or only the
#                                        named files of the project's, and print the summary.
#                                        --env: local (the default) or staging.
#                                        Browser: chromium (default), firefox, webkit,
#                                        mobile-chrome or mobile-safari.
#
# The tests are the project's own, in tests/presstest/, run in the PressTest runner image,
# ghcr.io/pie/presstest-runner. The image version, the shared suites and the staging site are the
# project's, from .claude/team/PROJECT.md, under Tests:
#
#   - **PressTest image:** `1.0.0`                       the runner image version the tests are pinned to
#   - **PressTest shared suites:** `wordpress-core`, `woocommerce-core`    suites in the image to run too
#   - **PressTest staging:** `https://staging.example.com`    the staging site's URL
#
# The image and staging lines are read from their first `code` span, or else their first word; the
# shared suites line from all its `code` spans, or else its words. "none" as the first word,
# whatever follows it, or the template's unfilled <prompt>, means there is none. PRESSTEST_IMAGE_VERSION, PRESSTEST_SHARED_SUITES and
# PRESSTEST_STAGING_URL in the environment override them. There is no production: the suites
# place orders.
#
# Everything else is the developer's own, in .claude/team/local.env (git-ignored), as KEY=value
# lines. The file is parsed, never executed. Other keys in it are left alone. A comment is a line
# starting with #, or ` #` after an unquoted value; a quoted value may hold a #. A value still in
# <angle brackets> is an unfilled example and counts as unset. An environment variable of the same
# name overrides the file.
#
#   LOCAL_URL=https://my-site.local         the local site, on a .local or .test domain, which
#                                           Docker can be pointed at
#   PRESSTEST_SECRET=...                    the site's report token (Presstest > Settings), for
#                                           tests that create test data: `run` starts a test session
#                                           with it, and ends it, removing the data, afterwards
#   PRESSTEST_USERNAME=  PRESSTEST_PASSWORD=                    a login, for suites that log in
#   PRESSTEST_CUSTOMER_USERNAME=  PRESSTEST_CUSTOMER_PASSWORD=  a shop customer, for suites
#                                                               that need one
#   PRESSTEST_STAGING_SECRET=  PRESSTEST_STAGING_USERNAME=  PRESSTEST_STAGING_PASSWORD=
#   PRESSTEST_STAGING_CUSTOMER_USERNAME=  PRESSTEST_STAGING_CUSTOMER_PASSWORD=
#                                           the same, for staging. Local values are never sent
#                                           to staging.
#
# Needs Docker, and curl and jq when there's a report token. Each `run` starts a new container
# from the image, removed when it ends; Docker pulls the image the first time a version is used.
# The image is private: Docker must be logged in to ghcr.io as someone who can read
# pie/presstest.io (see PROJECT.md, Local copies).
# The project's tests are mounted read-only at /all-tests/project. The report and the artifacts of
# failed tests go to .claude/presstest/ (git-ignored), kept until the next run.
#
# `run` ends with one line: `presstest: passed <n>` or `presstest: failed <n> of <total>`.
# Exit status: 0 everything passed; 1 a test failed or no report was written; 2 a usage or
# settings error, or the site doesn't answer or is password-protected, so nothing ran.

set -euo pipefail

die() { echo "presstest: $*" >&2; exit 2; }

root="$(git rev-parse --show-toplevel 2>/dev/null)" || die 'run me from inside the project repo'
cd "$root"
project="$root/.claude/team/PROJECT.md"
conf="$root/.claude/team/local.env"

# A `- **<label>:** value` line from PROJECT.md: its first code span, or else its first word.
# Whether a line's value is "none": its first word, plain or in a code span, whatever follows, so an
# explanation after it that names a suite or a site in a code span can't switch it back on.
is_none() {
	local first="${1#\`}"
	first="${first%%[^A-Za-z]*}"
	shopt -s nocasematch
	[[ "$first" == none ]]
	local rc=$?
	shopt -u nocasematch
	return $rc
}
project_line() {
	local line
	[ -f "$project" ] || return 0
	line="$(sed -n "s/^[[:space:]]*-[[:space:]]*\*\*$1:\*\*[[:space:]]*//p" "$project" | head -1)"
	if [[ "$line" == '<'* ]] || is_none "$line"; then
		return 0
	elif [[ "$line" =~ \`([^\`]*)\` ]]; then
		echo "${BASH_REMATCH[1]}"
	else
		echo "${line%%[[:space:],;(]*}"
	fi
}
# Every code span of a `- **<label>:** value` line, or else its words, one per line.
project_list() {
	local line
	[ -f "$project" ] || return 0
	line="$(sed -n "s/^[[:space:]]*-[[:space:]]*\*\*$1:\*\*[[:space:]]*//p" "$project" | head -1)"
	{ [[ "$line" == '<'* ]] || is_none "$line"; } && return 0
	if [[ "$line" == *\`* ]]; then
		while [[ "$line" =~ \`([^\`]*)\` ]]; do
			echo "${BASH_REMATCH[1]}"
			line="${line#*"${BASH_REMATCH[0]}"}"
		done
	else
		echo "$line" | tr -s ' ,;' '\n\n\n' | sed '/^$/d'
	fi
}
VERSION_FILE="$(project_line 'PressTest image')"
SHARED_FILE="$(project_list 'PressTest shared suites' | paste -sd ' ' -)"
STAGING_URL_FILE="$(project_line 'PressTest staging')"

# The developer's settings, from local.env. Each known KEY is held as KEY_FILE.
KEYS='LOCAL_URL PRESSTEST_SECRET PRESSTEST_USERNAME PRESSTEST_PASSWORD
	PRESSTEST_CUSTOMER_USERNAME PRESSTEST_CUSTOMER_PASSWORD PRESSTEST_STAGING_SECRET
	PRESSTEST_STAGING_USERNAME PRESSTEST_STAGING_PASSWORD PRESSTEST_STAGING_CUSTOMER_USERNAME
	PRESSTEST_STAGING_CUSTOMER_PASSWORD'
KEYLIST=" $(echo $KEYS) "
for key in $KEYS; do printf -v "${key}_FILE" '%s' ''; done
if [ -f "$conf" ]; then
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%$'\r'}"
		[[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
		[[ "$line" =~ ^[[:space:]]*([A-Z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
		key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
		[[ "$KEYLIST" == *" $key "* ]] || continue
		if [[ "$val" =~ ^\"([^\"]*)\"([[:space:]]+#.*)?[[:space:]]*$ || "$val" =~ ^\'([^\']*)\'([[:space:]]+#.*)?[[:space:]]*$ ]]; then
			val="${BASH_REMATCH[1]}"
		else
			val="${val%%[[:space:]]#*}"
			val="${val%"${val##*[![:space:]]}"}"
		fi
		[[ "$val" == '<'*'>' ]] && val=''
		printf -v "${key}_FILE" '%s' "$val"
	done < "$conf"
fi
# The environment's value, else the file's.
setting() { local file="${1}_FILE"; local env="${!1:-}"; echo "${env:-${!file}}"; }
VERSION="${PRESSTEST_IMAGE_VERSION:-$VERSION_FILE}"
SHARED="${PRESSTEST_SHARED_SUITES-$SHARED_FILE}"
STAGING_URL="${PRESSTEST_STAGING_URL:-$STAGING_URL_FILE}"
LOCAL_SITE="$(setting LOCAL_URL)"
IMAGE_REPO='ghcr.io/pie/presstest-runner'
TESTS="$root/tests/presstest"
RESULTS="$root/.claude/presstest"

shopt -s nocasematch
[[ "$VERSION" =~ ^(none)?$ ]] && VERSION=''
[[ "$SHARED" =~ ^[[:space:]]*(none)?[[:space:]]*$ ]] && SHARED=''
[[ "$STAGING_URL" =~ ^(none)?$ ]] && STAGING_URL=''
shopt -u nocasematch
read -ra shared <<< "$SHARED"

# Settings are checked before use, so a bad value can't change what runs or which site is tested.
[[ -z "$VERSION" || "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "the PressTest image in PROJECT.md must be a version like 1.0.0: $VERSION"
for s in ${shared[@]+"${shared[@]}"}; do
	[[ "$s" =~ ^[A-Za-z0-9_-]+$ && "$s" != project ]] || die "the PressTest shared suites in PROJECT.md must be suite names, like wordpress-core: $s"
done
IMAGE="$IMAGE_REPO:$VERSION"
DOMAIN=''
if [[ "$LOCAL_SITE" =~ ^https?://([A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.(local|test))(:[0-9]+)?(/.*)?$ ]]; then
	DOMAIN="${BASH_REMATCH[1]}"
fi
STAGING_OK=''
if [[ "$STAGING_URL" =~ ^https?://[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]] \
	&& ! [[ "$STAGING_URL" =~ ^https?://[^/:]+\.(local|test)(:|/|$) ]]; then
	STAGING_OK=1
fi

need_version() { [ -n "$VERSION" ] || die 'this project has no PressTest image version (PROJECT.md, Tests: PressTest image)'; }
project_tests() { [ -d "$TESTS" ] && (cd "$TESTS" && find . -name '*_test.js' -not -path '*/node_modules/*' | sed 's|^\./||' | sort); }
shown() { [ -n "$1" ] && echo '(set)' || echo '(not set)'; }

[ $# -ge 1 ] || die "no command. See the header of $0."
cmd="$1"; shift

case "$cmd" in
config)
	echo "repo:       $root"
	echo "image:      $([ -n "$VERSION" ] && echo "$IMAGE" || echo '(none)')"
	echo "tests:      $TESTS$([ -d "$TESTS" ] || echo ' (missing)') ($(project_tests | wc -l | tr -d ' ') files)"
	echo "shared:     ${SHARED:-(none)}"
	echo "settings:   $conf$([ -f "$conf" ] || echo ' (missing)')"
	echo "local:      ${LOCAL_SITE:-(not set)}$([ -z "$LOCAL_SITE" ] || [ -n "$DOMAIN" ] || echo ' (not a .local or .test site)')"
	echo "  secret:   $(shown "$(setting PRESSTEST_SECRET)")"
	echo "  login:    $(shown "$(setting PRESSTEST_USERNAME)$(setting PRESSTEST_PASSWORD)")"
	echo "  customer: $(shown "$(setting PRESSTEST_CUSTOMER_USERNAME)$(setting PRESSTEST_CUSTOMER_PASSWORD)")"
	echo "staging:    ${STAGING_URL:-(none)}$([ -z "$STAGING_URL" ] || [ -n "$STAGING_OK" ] || echo ' (not a staging URL)')"
	echo "  secret:   $(shown "$(setting PRESSTEST_STAGING_SECRET)")"
	echo "  login:    $(shown "$(setting PRESSTEST_STAGING_USERNAME)$(setting PRESSTEST_STAGING_PASSWORD)")"
	echo "  customer: $(shown "$(setting PRESSTEST_STAGING_CUSTOMER_USERNAME)$(setting PRESSTEST_STAGING_CUSTOMER_PASSWORD)")"
	;;
list)
	project_tests
	;;
run)
	browser='chromium' env='local'
	while [ $# -gt 0 ]; do
		case "$1" in
			-b) [ $# -ge 2 ] || die '-b needs a browser'; browser="$2"; shift 2 ;;
			--env) [ $# -ge 2 ] || die '--env needs local or staging'; env="$2"; shift 2 ;;
			-*) die "unknown option: $1" ;;
			*) break ;;
		esac
	done
	[[ "$browser" =~ ^(chromium|firefox|webkit|mobile-chrome|mobile-safari)$ ]] || die "unknown browser: $browser"
	need_version
	case "$env" in
	local)
		[ -n "$LOCAL_SITE" ] || die 'no LOCAL_URL: add your local site to .claude/team/local.env'
		[ -n "$DOMAIN" ] || die "LOCAL_URL must be a local site, on a .local or .test domain: $LOCAL_SITE"
		URL="$LOCAL_SITE"; P='PRESSTEST' ;;
	staging)
		[ -n "$STAGING_URL" ] || die 'this project has no staging site for PressTest (PROJECT.md, Tests: PressTest staging)'
		[ -n "$STAGING_OK" ] || die "the PressTest staging line in PROJECT.md must be a site's URL, not a local one: $STAGING_URL"
		URL="$STAGING_URL"; P='PRESSTEST_STAGING' ;;
	*) die "--env is local or staging; there is no PressTest from here on production: $env" ;;
	esac
	# Named files are the project's own; with none, the project's tests and its shared suites run.
	targets=()
	for f in "$@"; do
		[[ "$f" =~ ^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*_test\.js$ ]] || die "test files are named like checkout_test.js (see presstest list): $f"
		[ -f "$TESTS/$f" ] || die "no $f in tests/presstest (see presstest list)"
		targets+=("project/$f")
	done
	if [ ${#targets[@]} -eq 0 ]; then
		[ -z "$(project_tests)" ] || targets+=(project)
		targets+=(${shared[@]+"${shared[@]}"})
	fi
	[ ${#targets[@]} -gt 0 ] || die 'nothing to run: no tests in tests/presstest, and no shared suites (PROJECT.md, Tests: PressTest shared suites)'

	command -v docker >/dev/null 2>&1 || die 'needs Docker, which is not installed'
	docker info >/dev/null 2>&1 || die 'needs Docker running'
	secret="$(setting "${P}_SECRET")"
	if [ -n "$secret" ]; then
		command -v curl >/dev/null 2>&1 || die 'needs curl, to start the test session'
		command -v jq >/dev/null 2>&1 || die 'needs jq, to start the test session'
	fi

	# A local site's domain is mapped to the host, where Local serves it. Only this mapping
	# counts: Docker's DNS can pass on the host's /etc/hosts, where Local points the domain at ::1,
	# which inside the container is the container itself. Its certificate is self-signed, so it's
	# accepted, for these domains only.
	docker_args=(--rm)
	insecure=''
	if [ "$env" = local ]; then
		docker_args+=(--add-host "$DOMAIN:host-gateway")
		insecure=1 hint='is it started in Local?'
	else
		hint='is it up, and reachable from this machine?'
	fi
	if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
		echo "presstest: pulling $IMAGE"
		docker pull -q "$IMAGE" >&2 \
			|| die "$(printf '%s\n' "couldn't pull $IMAGE." \
				'The image is private. Log Docker in to ghcr.io once, in a normal terminal:' \
				'  gh auth refresh -h github.com -s read:packages   (approve the code in the browser)' \
				'  gh auth status                                    (read:packages must be listed)' \
				'  gh auth token | docker login ghcr.io -u "$(gh api user -q .login)" --password-stdin' \
				"If you have, check the version in PROJECT.md is published. The steps, and what to do without gh: the ada plugin's README, PressTest tests.")"
	fi

	# Exit 3: the site asks for a Basic auth password (such as a host's staging protection), which
	# the suite can't give, so every test would fail on it.
	answer=0
	docker run "${docker_args[@]}" -e NODE_NO_WARNINGS=1 -e NODE_TLS_REJECT_UNAUTHORIZED="$([ -n "$insecure" ] && echo 0 || echo 1)" "$IMAGE" \
		node -e 'fetch(process.argv[1], {signal: AbortSignal.timeout(20000)}).then(r => process.exit(r.status === 401 && /(^|,)\s*basic\b/i.test(r.headers.get("www-authenticate") || "") ? 3 : 0), () => process.exit(1))' "$URL" \
		|| answer=$?
	[ "$answer" -ne 3 ] \
		|| die "the site is password-protected (Basic auth), so the suite can't reach it: turn the protection off for the run, then back on afterwards ($URL)"
	[ "$answer" -eq 0 ] || die "the site doesn't answer from Docker: $hint ($URL)"

	# The last run's report and artifacts are replaced. The folder is made first, so Docker doesn't
	# create it as root.
	rm -rf "$RESULTS/run"
	mkdir -p "$RESULTS/run"

	# A test session lets the tests create users, orders and so on: the Presstest Companion plugin
	# records what the run creates, removes it when the session ends, and captures emails instead
	# of sending them. It is always ended, and its cookie (a bearer credential, which the image
	# writes to session-state.json) deleted, however the run ends. Without a report token, or when
	# the site refuses, logged-out tests still run, and tests that need a session fail saying why.
	api="${URL%/}/wp-json/presstest-companion/v1/sessions"
	session_id='' session_cookie=''
	# The token goes to curl as a header file, not an argument, so it's never on a command line.
	token_header() { printf 'X-Presstest-Token: %s\n' "$secret"; }
	session_end() {
		local response
		rm -f "$RESULTS/run/session-state.json"
		[ -n "$session_id" ] || return 0
		if response="$(curl --silent --show-error --max-time 300 --fail-with-body ${insecure:+--insecure} \
			-H @<(token_header) -X DELETE "$api/$session_id" 2>&1)"; then
			echo "presstest: ended test session $session_id: $(jq -c '.summary' <<< "$response" 2>/dev/null || echo "$response")"
			# The site puts cleanup off while it counts requests still running in the session, and
			# retries on its hourly expiry job, which needs WP-Cron. Until then the run's data stays.
			left="$(jq -r '.summary.outstanding // 0' <<< "$response" 2>/dev/null || echo 0)"
			state="$(jq -r '.status // "ended"' <<< "$response" 2>/dev/null || echo ended)"
			if [ "$state" != ended ] || { [[ "$left" =~ ^[0-9]+$ ]] && [ "$left" -gt 0 ]; }; then
				echo "presstest: test session $session_id not cleaned up: $left records left ($state). The site retries on its hourly job, which needs WP-Cron; where WP-Cron is off, an hour after the run: wp cron event run presstest_companion_expire_sessions"
			fi
		else
			echo "presstest: couldn't end test session $session_id; the site removes its data once the session expires, or an administrator can now, from Presstest > Settings. $response" >&2
		fi
		session_id=''
	}
	trap session_end EXIT
	if [ -n "$secret" ]; then
		status=0
		response="$(curl --silent --show-error --max-time 30 ${insecure:+--insecure} --write-out '\n%{http_code}' \
			-H @<(token_header) -H 'Content-Type: application/json' -X POST \
			--data "$(jq -n --arg label "ada: ${targets[*]} ($browser)" '{label: $label}')" "$api" 2>&1)" || status=$?
		code="$(tail -n 1 <<< "$response")" body="$(sed '$d' <<< "$response")"
		if [ "$status" -ne 0 ]; then
			echo "presstest: couldn't reach $URL to start a test session, so logged-in tests will fail" >&2
		elif [ "$code" != 201 ]; then
			echo "presstest: test session not started (HTTP $code): $(jq -r '.message // "no message"' <<< "$body" 2>/dev/null || echo 'unexpected response')" >&2
		else
			session_id="$(jq -r '.id' <<< "$body")" session_cookie="$(jq -r '.cookie.value' <<< "$body")"
			echo "presstest: started test session $session_id"
		fi
	fi

	# Secrets go in through the environment (-e NAME), so they're never on a command line. The
	# tests run as this user, so the results stay theirs; HOME is somewhere writable for a user the
	# image doesn't know.
	export URL USERNAME="$(setting "${P}_USERNAME")" PASSWORD="$(setting "${P}_PASSWORD")" \
		CUSTOMER_USERNAME="$(setting "${P}_CUSTOMER_USERNAME")" CUSTOMER_PASSWORD="$(setting "${P}_CUSTOMER_PASSWORD")" \
		PRESSTEST_SESSION_ID="$session_id" PRESSTEST_SESSION_CREDENTIALS="$session_cookie" \
		PRESSTEST_STORAGE_STATE="$([ -n "$session_id" ] && echo test-results/run/session-state.json)" \
		IGNORE_HTTPS_ERRORS="$insecure"
	docker_args+=(--user "$(id -u):$(id -g)" -e HOME=/tmp
		-e URL -e USERNAME -e PASSWORD -e CUSTOMER_USERNAME -e CUSTOMER_PASSWORD
		-e PRESSTEST_SESSION_ID -e PRESSTEST_SESSION_CREDENTIALS -e PRESSTEST_STORAGE_STATE -e IGNORE_HTTPS_ERRORS
		-e REPORT_FILE=test-results/run/results.json -e OUTPUT_DIR=test-results/run/artifacts
		-v "$RESULTS:/app/test-results")
	[ ! -d "$TESTS" ] || docker_args+=(-v "$TESTS:/all-tests/project:ro")
	echo "presstest: $env, $URL, ${targets[*]}"
	ran=0
	docker run "${docker_args[@]}" "$IMAGE" playwright test "${targets[@]}" --project="$browser" || ran=$?
	session_end

	report="$RESULTS/run/results.json"
	if [ ! -f "$report" ]; then
		echo 'presstest: failed, no report written'
		exit 1
	fi
	# The numbers are the report's stats; the test entries hold strings, not numbers, under these keys.
	count() { { grep -oE "\"$1\": *[0-9]+" "$report" || true; } | tail -1 | grep -oE '[0-9]+$' || echo 0; }
	passed=$(( $(count expected) + $(count flaky) ))
	failed="$(count unexpected)"
	total=$(( passed + failed + $(count skipped) ))
	if [ "$failed" -gt 0 ]; then
		echo "presstest: failed $failed of $total; artifacts in .claude/presstest/run/artifacts"
		exit 1
	fi
	# Playwright can fail with no test failed (no tests found, an error before they start), and a
	# run where nothing passed proves nothing: either is a failure, never a pass.
	if [ "$ran" -ne 0 ]; then
		echo "presstest: failed, Playwright exited $ran with no test failed (see above)"
		exit 1
	fi
	if [ "$passed" -eq 0 ]; then
		echo 'presstest: failed, no test ran (see above)'
		exit 1
	fi
	echo "presstest: passed $passed"
	;;
*)
	die "unknown command: $cmd. See the header of $0."
	;;
esac
