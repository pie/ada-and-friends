#!/usr/bin/env bash
# Sets a repo up for the ada team. /ada:onboard runs it; a developer can too. Run from inside the
# project repo.
#
#   ada-onboard files KEY=value [KEY=value ...]
#       Copies the plugin's repo templates into the repo, never overwriting a file that exists,
#       and fills {{KEY}} placeholders in the files it copies. Reports any placeholder left.
#       Records a hash of each file it copies in .claude/team/.template-hashes, so refresh can
#       tell an untouched copy from an edited one.
#       Keys: PROJECT_NAME PACKAGE NAMESPACE TEXT_DOMAIN TIMEZONE CODE_DIR PROD_SSH PROD_PREFIX
#       PROD_LOGS
#   ada-onboard refresh [--force | --decline]
#       Brings the project's PR template up to the plugin's. /ada:begin runs it, so a project
#       picks up a new template on its first session after a plugin update. Prints one line per
#       template: current; refreshed (an untouched copy, replaced); declined (the developer kept
#       their own, asked again when the plugin's copy changes); or edited, or unknown (no hash
#       recorded), followed by the diff, with the file left alone. --force takes the plugin's
#       copy; --decline keeps the project's and records that.
#   ada-onboard gitignore [--list]
#       Adds the team's ignore lines to .gitignore if they're missing, among them
#       .claude/worktrees/, where ada-worktree makes each step's worktree. Prints kept or added
#       per line. With --list, prints the lines, one per line, and changes nothing: ada-worktree
#       new copies the ones that name a file (the developer's local config) into a new worktree.
#   ada-onboard settings
#       Merges the plugin, the marketplace and the team's permissions into .claude/settings.json,
#       keeping whatever is there. Switches off Claude Code's default commit and PR attribution;
#       the team adds its own. Keeps Ada's prompt cache for an hour (promptCacheTtl), unless the
#       project already sets it. Reads the SSH host from .claude/team/prod.env to deny direct
#       SSH to it. Prints the result.
#   ada-onboard check
#       Lists what's still missing or still holds a placeholder.

set -euo pipefail

die() { echo "ada-onboard: $*" >&2; exit 2; }
root="$(git rev-parse --show-toplevel 2>/dev/null)" || die 'run me from inside the project repo'
src="$(cd "$(dirname "$0")/../templates/repo" && pwd)"
# Python 3.8+: python3 on Mac and Linux. On Windows (Git Bash) it's often python or py -3, and
# the python3 there can be a Microsoft Store shortcut that runs nothing, so each is tried.
PY=()
for c in python3 python 'py -3'; do
	read -ra try <<<"$c"
	if "${try[@]}" -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
		PY=("${try[@]}"); break
	fi
done
[ ${#PY[@]} -gt 0 ] || die 'Python 3.8 or later is needed (as python3, python or py -3)'
# Windows Pythons print CRLF; the shell compares plain lines.
py() { "${PY[@]}" "$@" | tr -d '\r'; }

cmd="${1:-}"; shift || true

# .claude/team/.template-hashes has one line per template: "<copied|declined> <sha256> <path>".
# copied is the hash of what was written into the project; declined, of the plugin's copy the
# developer turned down. Hashes are of the text with LF line endings.
HASHES_PY='
import hashlib, os
def norm(text):
    return text.replace("\r\n", "\n")
def sha(text):
    return hashlib.sha256(norm(text).encode("utf-8")).hexdigest()
def hashes_path(root):
    return os.path.join(root, ".claude", "team", ".template-hashes")
def read_hashes(root):
    out = {}
    if os.path.exists(hashes_path(root)):
        for line in open(hashes_path(root), encoding="utf-8"):
            parts = line.split(None, 2)
            if len(parts) == 3:
                out[parts[2].strip()] = (parts[0], parts[1])
    return out
def write_hashes(root, hashes):
    os.makedirs(os.path.dirname(hashes_path(root)), exist_ok=True)
    with open(hashes_path(root), "w", encoding="utf-8", newline="\n") as f:
        for rel in sorted(hashes):
            f.write(f"{hashes[rel][0]} {hashes[rel][1]} {rel}\n")
'

case "$cmd" in
files)
	ADA_SRC="$src" ADA_ROOT="$root" ADA_HASHES="$HASHES_PY" py - "$@" <<'PY'
import os, re, sys
exec(os.environ['ADA_HASHES'])
src, root = os.environ['ADA_SRC'], os.environ['ADA_ROOT']
keys = {'PROJECT_NAME','PACKAGE','NAMESPACE','TEXT_DOMAIN','TIMEZONE','CODE_DIR','PROD_SSH','PROD_PREFIX','PROD_LOGS'}
values = {}
for arg in sys.argv[1:]:
    k, sep, v = arg.partition('=')
    if not sep or k not in keys:
        sys.exit(f'ada-onboard: expected KEY=value with KEY one of {" ".join(sorted(keys))}: {arg}')
    if '\n' in v or '{{' in v:
        sys.exit(f'ada-onboard: bad value for {k}')
    values[k] = v
left = set()
hashes = read_hashes(root)
for dirpath, _, files in os.walk(src):
    for name in sorted(files):
        s = os.path.join(dirpath, name)
        rel = os.path.relpath(s, src)
        d = os.path.join(root, rel)
        if os.path.exists(d):
            print(f'kept     {rel}')
            continue
        os.makedirs(os.path.dirname(d), exist_ok=True)
        text = open(s, encoding='utf-8').read()
        for k, v in values.items():
            text = text.replace('{{' + k + '}}', v)
        open(d, 'w', encoding='utf-8', newline='\n').write(text)
        os.chmod(d, os.stat(s).st_mode & 0o777)
        hashes[rel.replace(os.sep, '/')] = ('copied', sha(text))
        missing = sorted(set(re.findall(r'\{\{([A-Z_]+)\}\}', text)))
        print(f'created  {rel}' + (f'   (still to fill: {", ".join(missing)})' if missing else ''))
        left.update(missing)
write_hashes(root, hashes)
if left:
    print('\nPlaceholders left: ' + ', '.join(sorted(left)))
PY
	;;
refresh)
	mode="${1:-}"
	case "$mode" in ''|--force|--decline) ;; *) die 'usage: ada-onboard refresh [--force | --decline]' ;; esac
	ADA_SRC="$src" ADA_ROOT="$root" ADA_HASHES="$HASHES_PY" ADA_MODE="$mode" py - <<'PY'
import difflib, os
exec(os.environ['ADA_HASHES'])
src, root, mode = os.environ['ADA_SRC'], os.environ['ADA_ROOT'], os.environ['ADA_MODE']
# Only templates without {{KEY}} placeholders can be refreshed: refresh has no values to fill.
REFRESH = ['.github/pull_request_template.md']
hashes = read_hashes(root)
changed = False
for rel in REFRESH:
    plugin = norm(open(os.path.join(src, rel), encoding='utf-8').read())
    d = os.path.join(root, rel)
    project = norm(open(d, encoding='utf-8').read()) if os.path.exists(d) else None
    state, h = hashes.get(rel, (None, None))
    if project == plugin:
        print(f'current   {rel}')
    elif mode == '--force' or project is None or (state == 'copied' and sha(project) == h):
        os.makedirs(os.path.dirname(d), exist_ok=True)
        open(d, 'w', encoding='utf-8', newline='\n').write(plugin)
        hashes[rel] = ('copied', sha(plugin)); changed = True
        print(f'refreshed {rel}')
    elif mode == '--decline':
        hashes[rel] = ('declined', sha(plugin)); changed = True
        print(f'declined  {rel}')
    elif state == 'declined' and h == sha(plugin):
        print(f'declined  {rel}')
    else:
        print(f"{'unknown' if state is None else 'edited':<9} {rel}")
        print(''.join(difflib.unified_diff(project.splitlines(True), plugin.splitlines(True),
                                           f'project/{rel}', f'plugin/{rel}')), end='')
if changed:
    write_hashes(root, hashes)
PY
	;;
gitignore)
	# ada-worktree new copies the lines that name a file into a new worktree (--list).
	ignore_lines=('.claude/handoff/' '.claude/worktrees/' '.claude/settings.local.json' '.claude/team/local.env' '.phpunit.cache/' 'tools/vendor/')
	case "${1:-}" in
	--list)
		[ $# -eq 1 ] || die 'usage: ada-onboard gitignore [--list]'
		printf '%s\n' "${ignore_lines[@]}"
		exit 0
		;;
	'') ;;
	*) die 'usage: ada-onboard gitignore [--list]' ;;
	esac
	gi="$root/.gitignore"; touch "$gi"
	for line in "${ignore_lines[@]}"; do
		grep -qxF "$line" "$gi" && echo "kept     $line" || { echo "$line" >> "$gi"; echo "added    $line"; }
	done
	;;
settings)
	host=''
	if [ -f "$root/.claude/team/prod.env" ]; then
		host="$(sed -n 's/^[[:space:]]*PROD_SSH[[:space:]]*=[[:space:]]*\([A-Za-z0-9._-]*@[A-Za-z0-9.-]*\)[[:space:]]*$/\1/p' "$root/.claude/team/prod.env" | head -1)"
	fi
	ADA_ROOT="$root" ADA_HOST="$host" py - <<'PY'
import json, os
root, host = os.environ['ADA_ROOT'], os.environ['ADA_HOST']
path = os.path.join(root, '.claude', 'settings.json')
data = json.load(open(path, encoding='utf-8')) if os.path.exists(path) else {}
data.setdefault('extraKnownMarketplaces', {})['pie'] = {'source': {'source': 'github', 'repo': 'pie/ada-and-friends'}}
data.setdefault('enabledPlugins', {})['ada@pie'] = True
# The team credits each role in its own trailers (/ada:begin, Commits and credit), so Claude
# Code's default attribution is switched off.
data.setdefault('attribution', {}).update({'commit': '', 'pr': ''})
# Ada waits on roles and the developer for longer than the default five-minute cache, and each
# miss re-caches her whole context. An hour's cache costs more to write but is rarely missed.
data.setdefault('promptCacheTtl', '1h')
perms = data.setdefault('permissions', {})
def add(kind, rules):
    lst = perms.setdefault(kind, [])
    for r in rules:
        if r not in lst:
            lst.append(r)
add('allow', [
    'Bash(ada-handoff-init*)', 'Bash(ada-onboard refresh)', 'Bash(prod-wp *)', 'Bash(presstest *)', 'Bash(ada-brief *)', 'Bash(ada-plan *)', 'Bash(ada-size *)',
    # ada-worktree new and remove make and delete a directory, so they still ask.
    'Bash(ada-worktree check)', 'Bash(ada-worktree list)', 'Bash(ada-worktree main)',
    'Bash(php -l *)', 'Bash(tools/vendor/bin/phpcs *)', 'Bash(tools/vendor/bin/phpunit*)',
    'Bash(composer install -d tools*)',
    'Bash(git status*)', 'Bash(git diff*)', 'Bash(git log*)', 'Bash(git branch*)', 'Bash(git merge-base *)',
    # Read-only commands the roles use all the time. The efficiency skill asks for one simple
    # command per call, so these match; a compound command still asks.
    'Bash(git show *)', 'Bash(git rev-parse *)', 'Bash(git reflog*)', 'Bash(git worktree list*)',
    'Bash(grep *)', 'Bash(rg *)', 'Bash(ls *)', 'Bash(wc *)', 'Bash(head *)', 'Bash(tail *)',
    'Bash(cat *)', 'Bash(sed -n *)', 'Bash(which *)',
    'Bash(gh pr view*)', 'Bash(gh api user*)',
    # The roles write their handoff files and Tess writes tests; nothing else is pre-allowed.
    'Edit(/.claude/handoff/**)', 'Edit(/tests/**)',
])
deny = ['Bash(git push origin production*)', 'Bash(git push origin next-release*)', 'Bash(git push --force*)']
if host:
    user, _, h = host.partition('@')
    deny += [f'Bash(ssh *{h}*)', f'Bash(ssh {user}*)']
add('deny', deny)
os.makedirs(os.path.dirname(path), exist_ok=True)
open(path, 'w', encoding='utf-8', newline='\n').write(json.dumps(data, indent=2) + '\n')
print(open(path, encoding='utf-8').read())
PY
	;;
check)
	# This script's folder, worked out before the cd below so a relative $0 still resolves.
	here="$(cd "$(dirname "$0")" && pwd)"
	cd "$root"
	for f in CLAUDE.md .claude/team/PROJECT.md .claude/team/SYSTEM.md .claude/team/API.md \
	         .claude/team/STANDARDS.md .claude/team/TEST-AREAS.md .claude/team/prod.env \
	         .claude/settings.json tests/README.md tools/composer.json phpcs.xml.dist phpunit.xml.dist; do
		[ -e "$f" ] || { echo "missing  $f"; continue; }
		if grep -qE '\{\{[A-Z_]+\}\}' "$f"; then
			echo "fill in  $f: $(grep -oE '\{\{[A-Z_]+\}\}' "$f" | sort -u | tr '\n' ' ')"
		# A <prompt> counts outside code only: `<type>/<slug>` in backticks or a fence is syntax.
		elif [[ "$f" == *.md ]] && prompts="$(awk '/^ *```/ { fence = !fence; next } !fence' "$f" |
				sed -E 's/`[^`]*`//g' | grep -cE '<[A-Za-z][^<>]{3,}>')" && [ "$prompts" -gt 0 ]; then
			echo "draft    $f: $prompts line(s) still hold a <prompt> to replace"
		else
			echo "ok       $f"
		fi
	done
	[ -f .claude/settings.json ] && grep -q '"ada@pie"' .claude/settings.json || echo "missing  ada@pie in .claude/settings.json (run: ada-onboard settings)"
	if [ -f .claude/team/PROJECT.md ]; then
		grep -q '^## Brief approval' .claude/team/PROJECT.md || echo 'missing  "Brief approval" section in .claude/team/PROJECT.md (see the plugin template)'
		out="$("$here/ada-brief" who 2>&1 >/dev/null)" || echo "error    brief approval: $out"
	fi
	;;
*)
	die 'usage: ada-onboard files KEY=value... | refresh [--force | --decline] | gitignore | settings | check (see the header of this script)'
	;;
esac
